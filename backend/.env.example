# AeroYield Backend Configuration
# ---------------------------------
# Copy this to .env and fill in real values for production.

APP_NAME=AeroYield
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database — defaults to local SQLite; swap to PostgreSQL for production
DATABASE_URL=sqlite:///./aeroyield.db

# API Keys (comma-separated list of valid keys)
API_KEYS=dev-key-aeroyield-2026,admin-key-aeroyield-2026

# NASA POWER API (no key needed, but base URL is configurable)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Audio advisory storage
AUDIO_CACHE_DIR=./audio_cache

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://aeroyield-one.vercel.app

# Model
MODEL_PATH=./crop_vital_model.pkl
MODEL_VERSION=1.0
MODEL_METADATA_PATH=./crop_vital_model_metadata.json
